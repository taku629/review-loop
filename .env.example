# Optional: enables tiered AI hints (Hint 1 → Hint 2 → Approach) in `npm run dev` / `npm run preview`.
# The app works fully without it. The key is only read by the local Vite server, never sent to the browser.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
